# Copy this file to `.env` and adjust. `.env` is gitignored (keep secrets out of git).

# Where the server listens. Leave HOST at 127.0.0.1 for local dev.
HOST=127.0.0.1
PORT=8443

# Where the SQLite database file lives (created automatically on first run).
DATA_DIR=./data

# Seeded on the very first run only. Change this before deploying.
ADMIN_PASSWORD=change-me-before-first-run

# How long a login stays valid, in days. 0 disables expiry.
SESSION_TTL_DAYS=30

# Allow self-registration at all. true is convenient in dev; false closes it entirely.
ALLOW_REGISTRATION=true

# When registration is allowed, also require a valid admin-minted invite code.
# Leave false in dev for open sign-up; set true in production (invite-only).
REQUIRE_INVITE=false

# This file is loaded at boot (see src/env.ts). Real shell / systemd environment
# variables take precedence over anything set here. Point elsewhere with ENV_FILE.

node_modules/
dist/
data/
.env
*.log

# emoji image files (served from disk, not committed) — including the
# transfer tarball (59 MB; it was accidentally tracked once)
emoji/*
!emoji/README.txt
!emoji/special/
emoji.tar.gz

# playwright-mcp session artifacts + stray screenshots
.playwright-mcp/
solace-login.png

# LiveKit server binary (downloaded, not committed)
livekit/

# desktop shell build artifacts (the updater SIGNING KEY lives outside the
# repo entirely: ~/.tauri/solace-updater.key + .pass — never commit a copy)
desktop/src-tauri/target/
desktop/src-tauri/target-pop/
desktop/src-tauri/gen/
desktop/dist-publish/
desktop/ci-mac*/

# the game's Tauri build artifacts
game/src-tauri/target/
game/src-tauri/gen/
game/dist-publish/

# game textures: fetched by game/scripts/fetch-assets.mjs (pinned CC0 sets
# from ambientCG) — not committed; the vite build bundles them into dist
game/public/assets/

# Josh's licensed asset packs (their licenses forbid redistribution as raw
# files — processed copies ship inside the game installer, which is normal
# in-project use; game/scripts/prepare-assets.mjs consumes these)
assets/Hazmat*/
assets/Liminal*/
assets/TheBackroomsAndPoolrooms*/

# stray audit screenshots (Playwright saves to repo root)
/*.jpeg
/*.png

audition/

# reference images / raw sounds Josh drops in assets/ for look-dev (not ours
# to redistribute; the packs above are consumed by prepare-assets instead)
assets/*.png
assets/*.wav
# Josh's look-dev drops: the pools REFERENCE IMAGES (the map is built from
# them — BACKROOMS.md records what each one shows) and the raw ambience packs
# (900MB; the mastered ogg that ships lives in client/public/assets).
assets/references/
assets/ambience/
# the raw SCP-096 drop for the Poolrooms creature — the copies that SHIP are
# client/public/assets/pools/shy.{glb,…} and the mastered shy-scream.ogg
assets/pools entity/
# THE JUKEBOX's records. Josh drops MP3s here and scripts/ingest-jukebox.mjs
# copies them into data/uploads/music, which is what the server actually
# serves (and what the backups already sweep up). Music isn't ours to
# redistribute, and it has no business in a git history either way — deploying
# a new record means scp'ing the folder up and running the ingest, exactly like
# the emoji art.
assets/casino/jukebox playlist/
# Josh's raw model/asset archives (the processed copies live under
# client/public/assets/casino).
assets/casino/*.rar
assets/casino/*.zip

# SOLACE SATELLITE desktop app (satellite-app/): build outputs only. The
# sidecar exe is an 88MB Node SEA build regenerated by
# scripts/build-satellite-exe.mjs — never committed.
satellite-app/node_modules/
satellite-app/src-tauri/target/
satellite-app/src-tauri/binaries/
satellite-app/src-tauri/gen/
scripts/.satellite-sea/
# The member-gated installer GET /api/satellite/app streams (24MB binary —
# lives on the R220 at /opt/solace/satellite-dist/, staged here for dev).
satellite-dist/
scripts/.satellite-sea-linux/
scripts/.satellite-sea-cache/

# Pipe Dreams (Level 2) raw packs Josh supplied; the shrunk/extracted copies
# that ship live under client/public/assets/pipes.
assets/pipe dreams/

# The prop pipeline's working cache (scripts/props/extract.mjs) — regenerable;
# what ships is client/public/assets/propkit + src/backrooms/props-catalog.json.
assets/_propcache/

# THE NEW-ASSET INTAKE (scripts/props/intake.mjs): Josh's inbox, the untouched
# downloads it files away, and the fixed models it writes — pipeline inputs on
# this box only, like the other source packs. What ships is
# client/public/assets/propkit + src/backrooms/props-catalog.json.
assets/New Assets/
assets/downloads/
assets/kit/

__pycache__/
scripts/rollo/voice-previews/

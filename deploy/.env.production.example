# Production environment for Solace. Copy to /opt/solace/.env, then lock it down:
#   sudo -u solace cp deploy/.env.production.example /opt/solace/.env
#   sudo chmod 600 /opt/solace/.env && sudo chown solace:solace /opt/solace/.env
# The app loads this at boot (src/env.ts). After any change: systemctl restart solace

# Bind to localhost only — Caddy is the public front door.
HOST=127.0.0.1
PORT=8443

# Persistent data (SQLite DB + avatar uploads). This directory is what the
# backup job captures — keep it on durable storage.
DATA_DIR=/opt/solace/data

# CHANGE THIS BEFORE THE VERY FIRST BOOT. It seeds the admin account exactly
# once, when the database is empty. Editing it later does nothing (you'd have to
# rehash the DB row) — so get it right the first time.
ADMIN_PASSWORD=CHANGE-ME-to-a-strong-unique-passphrase

# Invite-only sign-up: registration stays on, but every new account must present
# an admin-minted invite code (generate them in the in-app admin Settings panel).
# Set ALLOW_REGISTRATION=false instead to close registration entirely.
ALLOW_REGISTRATION=true
REQUIRE_INVITE=true

# How long a login stays valid, in days (0 disables expiry).
SESSION_TTL_DAYS=30

# Voice (LiveKit) — optional. Leave these unset and the voice UI simply hides
# itself. To enable: install the LiveKit server (deploy/README.md §8b), run
# `livekit-server generate-keys`, put the pair in /etc/livekit.yaml AND here.
# NEVER use the devkey/secret pair in production.
#LIVEKIT_URL=wss://solace.zone/livekit
#LIVEKIT_API_KEY=
#LIVEKIT_API_SECRET=

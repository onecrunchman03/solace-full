{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solace Satellite",
  "version": "0.6.5",
  "identifier": "zone.solace.satellite",
  "build": {
    "frontendDist": "../ui"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDRDhCNTNFMzdEOTlCODgKUldTSW05azNQclhZM0ppWmlqa2k0eitnekZxUFRlRG5oTWtVYVBQZWNJaW5nYW1PaXlsOEhjVWIK",
      "endpoints": [
        "https://solace.zone/api/satellite/update/latest"
      ]
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Solace Satellite",
        "width": 780,
        "height": 640,
        "minWidth": 560,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/satellited",
      "binaries/livekit-server"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "C:/Users/you/code/solace/satellite-app/src-tauri/sign.ps1",
          "%1"
        ]
      }
    }
  }
}

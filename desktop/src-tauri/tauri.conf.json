{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Solace",
  "version": "0.3.7",
  "identifier": "zone.solace.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Solace",
        "width": 1280,
        "height": 830,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "zoomHotkeysEnabled": true,
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36 Edg/126.0.0.0 SolaceShell/0.3.7"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "windows": {
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File sign.ps1 %1",
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDRDhCNTNFMzdEOTlCODgKUldTSW05azNQclhZM0ppWmlqa2k0eitnekZxUFRlRG5oTWtVYVBQZWNJaW5nYW1PaXlsOEhjVWIK",
      "endpoints": ["https://solace.zone/desktop/latest.json"]
    }
  }
}
